# App
APP_NAME=AetherQore Pharmacy OS
ENVIRONMENT=development
DEBUG=true

# Security (change in production)
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://aetherqore:aetherqore_dev@localhost:5432/aetherqore

# API
API_HOST=127.0.0.1
API_PORT=8000

# Development demo user (change before real pharmacy use)
